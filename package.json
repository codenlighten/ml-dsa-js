{
  "name": "ml-dsa-browser-cdn",
  "version": "0.2.0",
  "description": "Browser CDN bundle for post-quantum ML-DSA signatures (FIPS-204) with dual-stack ECDSA, mnemonic derivation, and role-based key management.",
  "type": "module",
  "author": {
    "name": "Gregory J. Ward",
    "email": "greg@smartledger.technology",
    "url": "https://smartledger.technology"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenlighten/ml-dsa-js.git"
  },
  "homepage": "https://github.com/codenlighten/ml-dsa-js#readme",
  "bugs": {
    "url": "https://github.com/codenlighten/ml-dsa-js/issues"
  },
  "main": "dist/mldsa.esm.js",
  "exports": {
    ".": {
      "import": "./dist/mldsa.esm.js"
    },
    "./browser": "./dist/mldsa.min.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "test": "node --test",
    "check": "npm run build && npm test",
    "gen-vectors": "node scripts/gen-vectors.mjs",
    "proxy:dev": "node examples/simplebsv-proxy-server.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "post-quantum",
    "ml-dsa",
    "dilithium",
    "crypto",
    "browser",
    "cdn"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noble/post-quantum": "0.5.4",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
