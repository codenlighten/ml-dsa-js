{
  "name": "@smartledger.technology/ml-dsa",
  "version": "0.3.0",
  "description": "Browser CDN bundle for post-quantum ML-DSA signatures (FIPS-204) with dual-stack ECDSA, mnemonic derivation, and role-based key management.",
  "type": "module",
  "author": {
    "name": "Gregory J. Ward",
    "email": "greg@smartledger.technology",
    "url": "https://smartledger.technology"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenlighten/ml-dsa-js.git"
  },
  "homepage": "https://github.com/codenlighten/ml-dsa-js#readme",
  "bugs": {
    "url": "https://github.com/codenlighten/ml-dsa-js/issues"
  },
  "main": "dist/mldsa.esm.js",
  "types": "dist/mldsa.esm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mldsa.esm.d.ts",
      "import": "./dist/mldsa.esm.js"
    },
    "./browser": {
      "types": "./dist/mldsa.min.d.ts",
      "default": "./dist/mldsa.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/mldsa.js",
    "./dist/mldsa.min.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist",
    "test": "node --test",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check": "npm run build && npm run check:types && npm test",
    "gen-vectors": "node scripts/gen-vectors.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "post-quantum",
    "ml-dsa",
    "dilithium",
    "crypto",
    "browser",
    "cdn"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noble/post-quantum": "0.5.4",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "5.9.2"
  }
}
